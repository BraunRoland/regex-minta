<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Regex</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Profil szerkeztés</h1>
    <form method="post">
        <label> Usernév: <br>
            <input type="text" name="username">
            <% if (locals.error && locals.userErr != null) {%>
                <p><%= locals.userErr %></p>
            <% } %>
        </label> <br>
        <label> Nicknév: <br>
            <input type="text" name="nickname">
            <% if (locals.error && locals.nickErr != null) {%>
                <p><%= locals.nickErr %></p>
            <% } %>
        </label><br>
        <label> HEX-kód: <br>
            <input type="text" name="hex">
            <% if (locals.error && locals.hexErr != null) {%>
                <p><%= locals.hexErr %></p>
            <% } %>
        </label><br>
        <label> Profilkép: <br>
            <input type="text" name="https">
            <% if (locals.error && locals.profileErr != null) {%>
                <p><%= locals.profileErr %></p>
            <% } %>
        </label><br> <br>
        <button type="submit">Módosítás</button>
    </form>
</body>
</html>