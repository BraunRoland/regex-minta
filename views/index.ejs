<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Regex</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Profil szerkeztés</h1>
    <form method="post">
        <label> Usernév: <br>
            <input type="text" name="username">
        </label>
        <label> Nicknév: <br>
            <input type="text" name="nickname">
        </label>
        <label> HEX-kód: <br>
            <input type="text" name="hex">
        </label>
        <label> Profilkép: <br>
            <input type="text" name="https">
        </label>
        <% if (locals.error) {%>
            <p><%= locals.error %></p>
        <% } %>
        <button type="submit">Módosítás</button>
    </form>
</body>
</html>